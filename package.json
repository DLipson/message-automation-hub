{
  "name": "message-automation-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "plugins"
  ],
  "scripts": {
    "dev": "npm run dev -w core",
    "settings": "npm run settings -w core",
    "start": "npm run start -w core",
    "start:settings": "npm run start:settings -w core",
    "secret:set:smtp": "npm run secret:set:smtp -w core",
    "typecheck": "npm run typecheck -w core && npm run typecheck -w plugins",
    "build": "npm run build -w core",
    "test": "npm run test -w core && npm run test -w plugins",
    "typecheck:core": "npm run typecheck -w core",
    "typecheck:plugins": "npm run typecheck -w plugins",
    "test:core": "npm run test -w core",
    "test:plugins": "npm run test -w plugins"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
